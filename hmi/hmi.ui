<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>hmiClass</class>
 <widget class="QMainWindow" name="hmiClass">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>800</width>
    <height>600</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>HMI 学习项目 - 阶段 6(工程文件)</string>
  </property>
  <widget class="QWidget" name="centralWidget">
   <layout class="QVBoxLayout" name="centralLayout">
    <item>
     <!-- ★★ 2026-10-20(P1-b):按钮行只剩"运行控制 + 计时"。
          原来这一行有 9 个元素(启动/停止/复位/保存工程/打开工程/导出历史CSV/
          导出报警CSV/演示画布/编辑器/运行时画面/报警配置/报警声音 + 计数器),
          每个 80x32 一排,主画面第一眼全是按钮 —— 而其中 8 个的功能
          在菜单栏里【已经有一模一样的入口】(工程/数据/画面/报警四个菜单)。
          同一个动作两个入口,权限还得绑两遍、还得永远保持一致 ——
          P1-a 之前正是这个状态:按钮绑了、菜单没绑。
          所以这里撤掉重复的那几个,只保留"主画面不放就会找不到"的三键。

          【撤掉的是哪几个、挪到哪】(功能一处没少,只是换了位置)
            保存工程/打开工程 → 工程菜单(还有 Ctrl+S / Ctrl+O)
            导出历史CSV/导出报警CSV → 数据菜单
            演示画布/编辑器/运行时画面 → 画面菜单
            报警配置/报警声音 → 报警菜单
          【留下的三个为什么必须留在主画面】启动/停止/复位是现场操作员
            一天按几十次的动作。塞进菜单 = 每次都要先展开菜单再点第二层 ——
            戴手套的时候鼠标慢,菜单展开那一下就是差别。

          ★ 为什么可以直接从 .ui 删掉而不是在代码里 hide:
            uic 生成的 ui.saveButton 等成员会一起消失,于是 hmi.cpp 里
            任何一处漏删的引用是【编译错误】,而不是"控件还在但看不见、
            权限还绑着、测试还在数它"这种静默腐烂。
            这跟"不手改 .ui 加 QMenu"的规矩不冲突:那条规矩针对的是
            加结构复杂的元素(元素顺序/属性格式写错会静默不生效),
            这里是删一整个自闭合的 <item> 块,uic 对它的处理是确定的。 -->
     <layout class="QHBoxLayout" name="buttonRowLayout">
      <item>
       <widget class="QPushButton" name="startButton">
        <property name="minimumSize">
         <size><width>120</width><height>52</height></size>
        </property>
        <property name="text"><string>启动</string></property>
       </widget>
      </item>
      <item>
       <widget class="QPushButton" name="stopButton">
        <property name="minimumSize">
         <size><width>120</width><height>52</height></size>
        </property>
        <property name="text"><string>停止</string></property>
       </widget>
      </item>
      <item>
       <widget class="QPushButton" name="resetButton">
        <property name="enabled"><bool>true</bool></property>
        <property name="minimumSize">
         <size><width>120</width><height>52</height></size>
        </property>
        <property name="text"><string>复位</string></property>
       </widget>
      </item>
      <item>
       <spacer name="buttonRowSpacer">
        <property name="orientation"><enum>Qt::Orientation::Horizontal</enum></property>
        <property name="sizeHint" stdset="0">
         <size><width>40</width><height>20</height></size>
        </property>
       </spacer>
      </item>
      <item>
       <!-- ★★ P1-c(2026-10-20):状态徽章从原来那一整行搬上来,跟运行控制同一行。

            【为什么要搬 —— 这就是"状态常驻"】
              原来 stateConnLayout 是 centralLayout 里【单独一行】,排在按钮行下面。
              而 centralLayout 里还压着一个 bottomTabs(最小高度 420)。
              纵向空间不够时,挤掉的一定是这行 —— 于是"状态"这个操作员最先
              要看的东西,反而是全屏唯一可能被压没的东西。
              搬进按钮行之后它跟 启动/停止/复位 处在同一条 52px 高的带子上,
              而那条带子是整个窗口最不可能被挤掉的一行(它撑着三个 120x52 的按钮)。
              ★ 顺带的好处:状态徽章现在紧挨着它描述的那三个按钮 ——
                按"启动"之后看到的是旁边一行"状态:运行中",而不是往下扫一眼。

            【为什么这里删掉了两个 inline 样式表】
              原来 stateLabel/connLabel 上写着 "color: red; font-size: 18px"。
              那是【死代码】:构造函数里的 updateUi() 一上来就调
              updateStateLabel()/updateConnLabel(),两者都 setStyleSheet(
              statusBadgeStyle(...)) 把它整个覆盖掉了 —— 也就是说这两行
              从来没有生效过,只是让人以为"徽章配色在 .ui 里定义"。
              真正定义它的是 hmi.cpp 的 statusBadgeStyle()(tst_Theme 那条
              badgeFontSizesStayInCodeNotInTheSheet 钉的就是这件事)。
              删掉的理由跟 numberLineEdit 那两个一样:inline 样式表会让 qss
              对这个控件【完全失效】,而且它让人以为改 .ui 能改到徽章。 -->
       <widget class="QLabel" name="stateLabel">
        <property name="minimumSize">
         <size><width>150</width><height>52</height></size>
        </property>
        <property name="text"><string>状态:已停止</string></property>
        <property name="alignment">
         <set>Qt::AlignmentFlag::AlignCenter</set>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QLabel" name="connLabel">
        <property name="minimumSize">
         <size><width>200</width><height>52</height></size>
        </property>
        <property name="text"><string>状态:已断开</string></property>
        <property name="alignment">
         <set>Qt::AlignmentFlag::AlignCenter</set>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QLineEdit" name="numberLineEdit">
        <property name="minimumSize">
         <size><width>110</width><height>52</height></size>
        </property>
        <property name="maximumSize">
         <size><width>160</width><height>16777215</height></size>
        </property>
        <property name="readOnly"><bool>true</bool></property>
        <property name="text"><string>0</string></property>
        <property name="alignment">
         <set>Qt::AlignmentFlag::AlignCenter</set>
        </property>
        <!-- ★ 原来这里是 "color: black; background-color: white" 的 inline 样式表。
             深色主题下它是一个刺眼的白色方块,而且 inline 样式表会让 qss
             对这个控件【完全失效】—— 想靠主题改它是不可能的。
             删掉它,配色交给 qss 里那两条:
               · QLineEdit            —— 深底浅字 + 圆角边框(跟别的输入框一致)
               · QLineEdit:read-only  —— 虚线边框 + 灰字,【只读要看起来就是只读】
             它就是只读的(由 counter 定时写入),所以走 :read-only 那条。
             它不是状态徽章、没有 inline 样式表,字号因此由 qss 的
             QWidget{font-size:11pt} 统一管 —— tst_Theme 的
             fontSizeIsDefinedOnceInTheSheet 也才不会被它多出一个字号。 -->
       </widget>
      </item>
     </layout>
    </item>
    <item>
     <layout class="QHBoxLayout" name="tcpConnLayout">
      <item>
       <!-- ★ 阶段 C · C.4(2026-09-18):协议选择下拉框,3 协议 — 教训 1.5:跨协议切工程弹错误 -->
       <widget class="QComboBox" name="protocolComboBox">
        <property name="minimumSize">
         <size><width>120</width><height>40</height></size>
        </property>
        <item>
         <property name="text"><string>Modbus</string></property>
        </item>
        <item>
         <property name="text"><string>S7</string></property>
        </item>
        <item>
         <property name="text"><string>EtherNet/IP</string></property>
        </item>
       </widget>
      </item>
      <item>
       <widget class="QLineEdit" name="ipEdit">
        <property name="text"><string>127.0.0.1</string></property>
        <property name="minimumSize">
         <size><width>120</width><height>40</height></size>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QLineEdit" name="portEdit">
        <property name="text"><string>502</string></property>
        <property name="minimumSize">
         <size><width>80</width><height>40</height></size>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QPushButton" name="connectButton">
        <property name="minimumSize">
         <size><width>80</width><height>40</height></size>
        </property>
        <property name="text"><string>连接</string></property>
       </widget>
      </item>
      <item>
       <widget class="QPushButton" name="disconnectButton">
        <property name="minimumSize">
         <size><width>80</width><height>40</height></size>
        </property>
        <property name="text"><string>断开</string></property>
       </widget>
      </item>
     </layout>
    </item>
    <item>
     <!-- ==== debugTabs:调试区拆成两页 ================================================
          2026-10-20(P1-e)。为什么拆:

          【真 bug,不是审美】P1-c 把这两行折进可折叠面板时,用的是
            centralLayout->takeAt() 把两个 QLayoutItem 摘出来,
            再 addItem() 给一个新面板的布局。控件本身没搬,只是换了"谁负责摆放它"。
            ★ 但新布局【没有重新 activate】—— 摘出来的两个布局保留了它们在
              centralLayout 里的旧几何,于是运行时它们照旧画在老位置上:
              实测 Modbus 那一行压在【启动/停止/复位】那一行上面,
              而面板自己的槽位是一块全黑空白。
              也就是说 P1-c 的折叠一展开就叠在一起,不是"看着不齐"。

          【这次改法:不再在运行期搬布局】
            两页直接写在 .ui 里,由 uic 生成正确的父子关系和几何 ——
            声明式的东西就该声明式地写,不是靠 takeAt/insertWidget 拼出来。
            centralLayout 里现在只有【一个】新 item(debugTabs),
            buildDebugPanel() 只负责在它前面插一个开关按钮 ——
            插一个【新建的】控件进布局是正常操作,没有"摘走旧 item"那类陈旧几何。

          【为什么是"两页"而不是两个折叠区】
            用户报的是"浮现在连接信息的上面,不好弄"。
            两页之后同一时刻只显示一行,调试区高度从两行(80px)降到一行(约 40px),
            既消掉了叠加,也把主画面让出 40px。
            连接那一行(协议/IP/端口/连接/断开)【不进】页签 ——
            连接是操作员的主动作,不该先点一下页签才够得着。
            变量模型展示(varDisplayLayout)也不进:它是实时数据,属于主画面。

          ★ 页内布局 margin 全设 0 —— QVBoxLayout 默认 9px 的四边留白
            会把 40px 高的那一行挤到 58px,两页高度就不一样了。 -->
     <widget class="QTabWidget" name="debugTabs">
      <property name="minimumSize">
       <size><width>0</width><height>76</height></size>
      </property>
      <widget class="QWidget" name="tabManualSend">
       <attribute name="title"><string>手动发送</string></attribute>
       <layout class="QVBoxLayout" name="tabManualSendLayout">
        <property name="leftMargin"><number>0</number></property>
        <property name="topMargin"><number>0</number></property>
        <property name="rightMargin"><number>0</number></property>
        <property name="bottomMargin"><number>0</number></property>
        <item>
           <layout class="QHBoxLayout" name="tcpSendLayout">
            <item>
             <widget class="QLineEdit" name="sendEdit">
              <property name="placeholderText"><string>01 03 00 00 0A</string></property>
              <property name="minimumSize">
               <size><width>200</width><height>40</height></size>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QPushButton" name="sendButton">
              <property name="minimumSize">
               <size><width>80</width><height>40</height></size>
              </property>
              <property name="text"><string>发送</string></property>
             </widget>
            </item>
           </layout>
        </item>
       </layout>
      </widget>
      <widget class="QWidget" name="tabModbus">
       <attribute name="title"><string>Modbus</string></attribute>
       <layout class="QVBoxLayout" name="tabModbusLayout">
        <property name="leftMargin"><number>0</number></property>
        <property name="topMargin"><number>0</number></property>
        <property name="rightMargin"><number>0</number></property>
        <property name="bottomMargin"><number>0</number></property>
        <item>
           <!-- 2026-07-07 重设计:阶段 2 第 4 练 — 通用 Modbus 发送面板
                ★★ 2026-10-20(P1-d)重排:这一行原来是【四个高度】。
                  按 qss 的 min-height + padding 逐个算:
                    QLineEdit   自然高 ≈ padding 4+4 + 边框 1+1 + 行高 17 ≈ 27px
                                 (三个输入框只写了 maximumSize 40,没写 minimumSize
                                  —— maximumSize 只是【上限】,不占满就不生效)
                    QComboBox  min-height 20 + padding 4+4 + 边框 1+1       = 30px
                    QPushButton min-height 20 + padding 6+6 + 边框 1+1       = 34px
                    QLabel      跟着字号走                                   ≈ 20px
                  所以那一行渲染出来是 27/30/30/27/27/34/20 —— 七个控件七种高度。
                  而它上面那一行 tcpSendLayout 是 40/40 —— 同一个折叠面板里的
                  两行连彼此都对不齐,这就是"看着拼凑"的来源,不是配色问题。
                  下面把这一行全部固定成 40px,和上面那行对齐。

                【为什么补了 5 个可见标签】
                  从机 / 地址 / 数据 三个框原本只有 placeholder,
                  而它们三个都有【默认值】(1 / 0 / 1)——
                  placeholder 只在框是空的时候才显示,所以默认状态下
                  那一行是「1 | 读 | 保持寄存器 | 0 | 1 | 发送 | 两个减号」,
                  从头到尾没有一个字说明那几个框是干什么的。
                  ★ 这里必须说为什么那个占位符写成"两个减号":
                    XML 注释里不许出现连续两个 ASCII 减号(uic 会直接报
                    "Expected '>', but got '[a-zA-Z]'",而且行号指到的是
                    注释里的一句无关中文,不看上下文根本猜不出是它干的)。
                  补标签是为了让"哪个框干什么"不依赖于"框恰好是空的"。
                  ★ 五个标签共用 objectName "fieldLabel"(qss 里按 #fieldLabel 上色)。
                    Qt 允许重名 objectName(只有 QML 才要求唯一),
                    这里没有 findChild 会去找它们,换成五个名字只是多五条 qss。

                【modbusResultLabel 删掉了 inline 样式表 —— 这次它不是死代码】
                  P1-c 删 stateLabel/connLabel 那两个 inline 样式表时,它们是死的
                  (运行时总被 statusBadgeStyle() 覆盖)。这一个不一样:
                  updateModbusLabel() 只 setText,不碰样式,所以那行
                  `color: blue; font-size: 14px; font-weight: bold;` 是【真的在显示】。
                  而深色主题下 #0000ff 压在 #232e3d 上,对比度只有 1.60:1
                  —— 而这张 qss 的文件头自己写着"正文至少 7:1"。
                  删掉之后回到 qss 的 #dfe8f2,对比度 11.09:1。
                  ★ inline 样式表还会让 qss 对这个控件【完全失效】,留着就是一条
                    与主题并行的第二套样式,改主题时它不会跟着变。 -->
           <layout class="QHBoxLayout" name="modbusLayout">
            <item>
             <widget class="QLabel" name="modbusSlaveLabel">
              <property name="objectName"><string>fieldLabel</string></property>
              <property name="text"><string>从机</string></property>
             </widget>
            </item>
            <item>
             <widget class="QLineEdit" name="modbusSlaveEdit">
              <property name="text"><string>1</string></property>
              <property name="placeholderText"><string>1-255</string></property>
              <property name="minimumSize">
               <size><width>50</width><height>40</height></size>
              </property>
              <property name="maximumSize">
               <size><width>50</width><height>40</height></size>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QLabel" name="modbusRwLabel">
              <property name="objectName"><string>fieldLabel</string></property>
              <property name="text"><string>读写</string></property>
             </widget>
            </item>
            <item>
             <widget class="QComboBox" name="modbusRwCombo">
              <property name="minimumSize">
               <size><width>60</width><height>40</height></size>
              </property>
              <item><property name="text"><string>读</string></property></item>
              <item><property name="text"><string>写</string></property></item>
             </widget>
            </item>
            <item>
             <widget class="QLabel" name="modbusTypeLabel">
              <property name="objectName"><string>fieldLabel</string></property>
              <property name="text"><string>区域</string></property>
             </widget>
            </item>
            <item>
             <widget class="QComboBox" name="modbusTypeCombo">
              <property name="minimumSize">
               <size><width>120</width><height>40</height></size>
              </property>
              <item><property name="text"><string>保持寄存器</string></property></item>
              <item><property name="text"><string>输入寄存器</string></property></item>
              <item><property name="text"><string>线圈</string></property></item>
              <item><property name="text"><string>离散输入</string></property></item>
             </widget>
            </item>
            <item>
             <widget class="QLabel" name="modbusAddrLabel">
              <property name="objectName"><string>fieldLabel</string></property>
              <property name="text"><string>地址</string></property>
             </widget>
            </item>
            <item>
             <widget class="QLineEdit" name="modbusAddrEdit">
              <property name="text"><string>0</string></property>
              <property name="placeholderText"><string>寄存器号</string></property>
              <property name="minimumSize">
               <size><width>80</width><height>40</height></size>
              </property>
              <property name="maximumSize">
               <size><width>80</width><height>40</height></size>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QLabel" name="modbusDataLabel">
              <property name="objectName"><string>fieldLabel</string></property>
              <property name="text"><string>数据</string></property>
             </widget>
            </item>
            <item>
             <widget class="QLineEdit" name="modbusDataEdit">
              <property name="text"><string>1</string></property>
              <property name="placeholderText"><string>数量 / 值</string></property>
              <!-- ★ 格式说明搬进 tooltip:placeholder 只有在框空的时候才看得见,
                     而这一栏【永远】有值(默认 1),所以放那儿等于没写。 -->
              <property name="toolTip"><string>读:这里是数量(1-125)
      写:这里是值,逗号分隔,支持 0x 前缀(如 1, 2, 0xFF)</string></property>
              <property name="minimumSize">
               <size><width>160</width><height>40</height></size>
              </property>
              <property name="maximumSize">
               <size><width>160</width><height>40</height></size>
              </property>
              <property name="maxLength"><uint>64</uint></property>
             </widget>
            </item>
            <item>
             <widget class="QPushButton" name="modbusSendButton">
              <property name="text"><string>发送</string></property>
              <!-- ★ 和上面 tcpSendLayout 里的 sendButton 同尺寸(80x40)——
                   同一个折叠面板里两个同名按钮长得不一样,是最扎眼的一处不一致。 -->
              <property name="minimumSize">
               <size><width>80</width><height>40</height></size>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QLabel" name="modbusResultLabel">
              <property name="text"><string>--</string></property>
              <property name="minimumSize">
               <size><width>110</width><height>40</height></size>
              </property>
              <property name="alignment"><set>Qt::AlignmentFlag::AlignLeading|Qt::AlignmentFlag::AlignVCenter</set></property>
             </widget>
            </item>
           </layout>
        </item>
       </layout>
      </widget>
      <!-- ★★ 2026-10-20:第三页「通讯监视」—— 帧级监视器。
           调试区第三页(手动发送 / Modbus 之后),把 ModbusMaster
           真正收发的那一帧一帧摊开:时间 / 方向 / 摘要 / 往返耗时 / 原始字节。

           【为什么放在调试区而不是底部数据页】
             它是【协议调试工具】,和「手打 hex 帧」「手填从站号」是同一类东西:
             现场排障时才用,平时该收着。而底部的实时/曲线/报警历史是
             值班人员要盯着看的常驻数据 —— 把调试工具混进去等于
             「值班的人也得面对一屏原始字节」。

           【这一页的高度是算出来的,不是拍脑袋定的】
             前面两页各只有一行 40px,这一页要塞一张表。
             若按「最高的页」统一高度,前两页下面会空出一大片黑;
             QStackedLayout 的 sizeHint 取的是【各页的最大值】,
             不显式定住的话它自己就会按最高页算 —— 于是前两页各空 160px。
             所以高度由 hmi.cpp 的 buildDebugPanel() 跟着【当前页】算
             (切页时面板伸缩一次,比一直空着强)。
             ★ 下面的 160 是【表格自己的固定高度】,
               面板总高 = 页签条 + 表格 160 + 底下一行 40 ≈ 240。

           【表格固定 160px 的取舍】
             固定住,是免得「帧来了面板就长高、面板长了下面全被推走」。
             代价是同时只看得见五六行 —— 但下面那行有累计统计
             (发/收/错帧数、字节数、往返耗时 min/平均/max),
             要看全量可以拖表格的滚动条。 -->
      <widget class="QWidget" name="tabCommTrace">
       <attribute name="title"><string>通讯监视</string></attribute>
       <layout class="QVBoxLayout" name="tabCommTraceLayout">
        <property name="leftMargin"><number>0</number></property>
        <property name="topMargin"><number>0</number></property>
        <property name="rightMargin"><number>0</number></property>
        <property name="bottomMargin"><number>0</number></property>
        <item>
         <widget class="QTableView" name="commTraceView">
          <property name="minimumSize">
           <size><width>0</width><height>160</height></size>
          </property>
          <!-- ★ 固定 160:min == max。
               只写 minimumSize 的话表格的 sizeHint(约 192)会赢,
               面板高度就随帧数变 —— 帧一多,整个调试区往下长,
               底下的实时数据区被推走。固定住,面板才稳定。 -->
          <property name="maximumSize">
           <size><width>16777215</width><height>160</height></size>
          </property>
          <property name="editTriggers">
           <set>QAbstractItemView::NoEditTriggers</set>
          </property>
          <!-- ★ 枚举必须【写全限定值】,不能写成
               <enum>QAbstractItemView::SelectionBehavior</enum>SelectRows
               那种"类型 + 行尾值"的写法 —— uic 不认那个写法:
               它会把类型当【值】照抄,生成
                 setSelectionBehavior(QAbstractItemView::SelectionBehavior);
               然后编译报 C2275("应为表达式,而不是类型")。
               ★★ 而且它是【静默】的:ninja 不会因为只改了 .ui 就重跑 uic,
               所以这个错要等到一次 -Clean 干净重建才会现形。
               实测(2026-10-20):两个 <enum> 的写法 uic 会按【控件类】去限定,
               生成 QTableView::SelectRows —— 能编过,但不是想要的那个类的枚举。 -->
          <property name="selectionBehavior">
           <enum>QAbstractItemView::SelectRows</enum>
          </property>
          <property name="wordWrap"><bool>false</bool></property>
          <property name="textElideMode">
           <enum>Qt::ElideRight</enum>
          </property>
         </widget>
        </item>
        <item>
         <layout class="QHBoxLayout" name="commTraceBottomLayout">
          <item>
           <widget class="QLabel" name="commTraceStatsLabel">
            <property name="minimumSize">
             <size><width>0</width><height>40</height></size>
            </property>
            <property name="text">
             <string>本次运行累计:发 0 / 收 0 / 错 0 帧;字节 出 0 / 入 0;往返 尚无样本</string>
            </property>
            <property name="alignment">
             <set>Qt::AlignmentFlag::AlignLeading|Qt::AlignmentFlag::AlignVCenter</set>
            </property>
            <property name="toolTip"><string>统计是【本次运行】的累计量,点「清空」不会把它抹掉:
错误帧数是累计的,抹掉会让「一直在报错」看起来像「刚启动」。</string></property>
           </widget>
          </item>
          <item>
           <spacer name="commTraceSpacer">
            <property name="orientation"><enum>Qt::Orientation::Horizontal</enum></property>
            <property name="sizeHint" stdset="0">
             <size><width>40</width><height>20</height></size>
            </property>
           </spacer>
          </item>
          <item>
           <widget class="QPushButton" name="commTracePauseButton">
            <property name="minimumSize">
             <size><width>80</width><height>40</height></size>
            </property>
            <property name="text"><string>暂停</string></property>
            <property name="checkable"><bool>true</bool></property>
            <property name="toolTip"><string>暂停采集:期间到达的帧一律不记(统计也停)。
排查时先暂停、再操作,免得新帧把要找的那几行冲掉。</string></property>
           </widget>
          </item>
          <item>
           <widget class="QPushButton" name="commTraceClearButton">
            <property name="minimumSize">
             <size><width>80</width><height>40</height></size>
            </property>
            <property name="text"><string>清空</string></property>
            <property name="toolTip"><string>只清帧列表,【不清统计】。
错误帧数是本次运行的累计量,抹掉会让「一直在报错」看起来像「刚启动」。</string></property>
           </widget>
          </item>
         </layout>
        </item>
       </layout>
      </widget>
     </widget>
    </item>
    <item>
     <!-- 阶段 3.2:变量模型展示(订阅发布 UI 验证) -->
     <layout class="QHBoxLayout" name="varDisplayLayout">
      <item>
       <widget class="QLabel" name="pressureLabel">
        <property name="minimumSize"><size><width>140</width><height>30</height></size></property>
        <property name="text"><string>压力(bar): --</string></property>
        <property name="alignment"><set>Qt::AlignmentFlag::AlignCenter</set></property>
        <property name="styleSheet"><string>font-size: 14px; font-weight: bold; color: #0066cc; background-color: #f0f8ff;</string></property>
       </widget>
      </item>
      <item>
       <widget class="QLabel" name="temperatureLabel">
        <property name="minimumSize"><size><width>140</width><height>30</height></size></property>
        <property name="text"><string>温度(℃): --</string></property>
        <property name="alignment"><set>Qt::AlignmentFlag::AlignCenter</set></property>
        <property name="styleSheet"><string>font-size: 14px; font-weight: bold; color: #cc6600; background-color: #fff8f0;</string></property>
       </widget>
      </item>
      <item>
       <widget class="QLabel" name="speedLabel">
        <property name="minimumSize"><size><width>140</width><height>30</height></size></property>
        <property name="text"><string>转速(rpm): --</string></property>
        <property name="alignment"><set>Qt::AlignmentFlag::AlignCenter</set></property>
        <property name="styleSheet"><string>font-size: 14px; font-weight: bold; color: #009933; background-color: #f0fff0;</string></property>
       </widget>
      </item>
      <!-- 阶段 4.2:UI → 变量 反向写测试入口(威纶通输入确认模式) -->
      <item>
       <widget class="QLineEdit" name="speedWriteEdit">
        <property name="minimumSize">
         <size><width>120</width><height>30</height></size>
        </property>
        <property name="placeholderText">
         <string>按回车写,Esc 取消</string>
        </property>
        <property name="alignment">
         <set>Qt::AlignmentFlag::AlignCenter</set>
        </property>
       </widget>
      </item>
     </layout>
    </item>
    <item>
     <!-- ★ D.2(2026-09-20):主窗口底部 QTabWidget,3 个标签 — 实时 / 曲线 / 报警历史
          实时 tab 沿用原 recvText + auditTable + alarmTable(对象名不变,hmi.cpp 不动);
          曲线 / 报警历史 tab 留 placeholder,D.2/D.3 接 TrendWidget / 报警历史表后填 widget。
          整体高度给 420,等于原来 3 个 widget 的 minimumSize 之和,避免 UI 缩崩。 -->
     <widget class="QTabWidget" name="bottomTabs">
      <property name="minimumSize">
       <size><width>0</width><height>420</height></size>
      </property>
      <widget class="QWidget" name="tabLive">
       <attribute name="title">
        <string>实时</string>
       </attribute>
       <layout class="QVBoxLayout" name="tabLiveLayout">
        <item>
         <widget class="QTextEdit" name="recvText">
          <property name="readOnly"><bool>true</bool></property>
          <property name="minimumSize">
           <size><width>0</width><height>150</height></size>
          </property>
         </widget>
        </item>
        <item>
         <!-- 阶段 4.x 写审计日志(2026-07-28):只 UI,显示最近写操作记录 -->
         <widget class="QTableWidget" name="auditTable">
          <property name="minimumSize">
           <size><width>0</width><height>120</height></size>
          </property>
         </widget>
        </item>
        <item>
         <!-- 阶段 5.4:报警列表 UI(最小版本:5 列 + 严重级闪烁,留等级过滤下次) -->
         <widget class="QTableWidget" name="alarmTable">
          <property name="minimumSize">
           <size><width>0</width><height>150</height></size>
          </property>
         </widget>
        </item>
       </layout>
      </widget>
      <widget class="QWidget" name="tabTrend">
       <attribute name="title">
        <string>曲线</string>
       </attribute>
       <layout class="QVBoxLayout" name="tabTrendLayout">
        <item>
         <!-- ★ D.2 placeholder:D.2 Trend 完成后用 QCustomPlot 替换这个 QLabel,
              hmi.cpp 里:bottomTabs->widget(1)->layout()->replaceWidget(labelWith +
                趋势控件);对象名 trendChartPlaceholder 方便后续 findChild -->
         <widget class="QLabel" name="trendChartPlaceholder">
          <property name="text">
           <string>(D.2 Trend 控件占位 — 接入后此 Label 会被替换为 QCustomPlot 曲线)</string>
          </property>
          <property name="alignment">
           <set>Qt::AlignmentFlag::AlignCenter</set>
          </property>
          <property name="styleSheet">
           <string>color: #888; font-size: 14px; background-color: #fafafa;</string>
          </property>
          <property name="minimumSize">
           <size><width>0</width><height>380</height></size>
          </property>
         </widget>
        </item>
       </layout>
      </widget>
      <widget class="QWidget" name="tabAlarmHistory">
       <attribute name="title">
        <string>报警历史</string>
       </attribute>
       <layout class="QVBoxLayout" name="tabAlarmHistoryLayout">
        <item>
         <!-- ★ D.3 placeholder:alarmHistoryTable 落库后接进这里,对象名保留方便 findChild -->
         <widget class="QLabel" name="alarmHistoryPlaceholder">
          <property name="text">
           <string>(D.3 报警历史占位 — alarm_history 表 + AlarmRecorder 接入后填这里)</string>
          </property>
          <property name="alignment">
           <set>Qt::AlignmentFlag::AlignCenter</set>
          </property>
          <property name="styleSheet">
           <string>color: #888; font-size: 14px; background-color: #fafafa;</string>
          </property>
          <property name="minimumSize">
           <size><width>0</width><height>380</height></size>
          </property>
         </widget>
        </item>
       </layout>
      </widget>
     </widget>
    </item>
   </layout>
  </widget>
  <widget class="QMenuBar" name="menuBar">
   <property name="geometry">
    <rect>
     <x>0</x><y>0</y><width>600</width><height>20</height>
    </rect>
   </property>
  </widget>
  <widget class="QToolBar" name="mainToolBar">
   <attribute name="toolBarArea">
    <enum>TopToolBarArea</enum>
   </attribute>
   <attribute name="toolBarBreak">
    <bool>false</bool>
   </attribute>
  </widget>
  <widget class="QStatusBar" name="statusBar"/>
 </widget>
 <layoutdefault spacing="6" margin="11"/>
 <resources>
  <include location="hmi.qrc"/>
 </resources>
 <connections/>
</ui>
