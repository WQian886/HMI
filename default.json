{
    "schema_version": "1.0",
    "project_name": "HMI Demo Project",
    "communications": {
        "host": "127.0.0.1",
        "port": 502,
        "protocol": "modbus_tcp",
        "modbus": {
            "timeout_ms": 3000,
            "max_retries": 5,
            "poll_interval_ms": 100
        }
    },
    "variables": [
        {
            "name": "Pressure",
            "address": 0,
            "data_type": "Int16",
            "access": "ReadOnly",
            "deadband": 0,
            "poll_interval_ms": 1000,
            "range": {"min": -1000, "max": 1000}
        },
        {
            "name": "Temperature",
            "address": 1,
            "data_type": "Int16",
            "access": "ReadOnly",
            "deadband": 0,
            "poll_interval_ms": 1000,
            "range": {"min": -100, "max": 200}
        },
        {
            "name": "Speed",
            "address": 2,
            "data_type": "UInt16",
            "access": "ReadWrite",
            "deadband": 0,
            "poll_interval_ms": 1000,
            "range": {"min": 0, "max": 65535}
        }
    ],
    "alarms": [
        {
            "name": "温度高",
            "variable": "Temperature",
            "level": "Critical",
            "direction": "Above",
            "threshold": 50,
            "min_duration_ms": 500
        },
        {
            "name": "温度低",
            "variable": "Temperature",
            "level": "Critical",
            "direction": "Below",
            "threshold": 10,
            "min_duration_ms": 500
        }
    ],
    "actions": [
        {
            "alarm_name": "温度高",
            "variable": "Speed",
            "write_value": 0
        },
        {
            "alarm_name": "温度低",
            "variable": "Speed",
            "write_value": 0
        }
    ]
}
